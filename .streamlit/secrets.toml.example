# Copie para .streamlit/secrets.toml (local) ou cole em
# Streamlit Community Cloud → App settings → Secrets.  NÃO envie para o Git.

# Acesso — escolha UM modo:
#  1) Contas de usuário (cada pessoa com usuário, senha e dados próprios). Exige DATABASE_URL (Supabase). Veja docs/contas_e_supabase.md
AUTH_MODE = "contas"
SIGNUP_CODE = "codigo-de-convite"         # exigido no cadastro (sem ele, qualquer pessoa com o link cria conta)
AUTH_SECRET = "texto-longo-e-aleatorio"   # assina o link "manter conectado"
# ALLOW_SIGNUP = "false"                  # fecha o cadastro depois que todos criarem a conta
# LEGACY_OWNER = "seu_usuario"            # quem herda os dados de antes das contas (uma vez)
#  2) Senha única para todos (sem AUTH_MODE):
# APP_PASSWORD = "troque-esta-senha"

# IA (DeepSeek via OpenRouter)
OPENROUTER_API_KEY = "sk-or-v1-..."

# --- Armazenamento permanente: escolha UMA das opções abaixo ---

# Opção A — mini banco no próprio GitHub (branch separado "tradebot-data").
# Token: GitHub → Settings → Developer settings → Fine-grained tokens →
#   acesso só a este repositório, permissão "Contents: Read and write".
# Atenção: em repositório público, o branch de dados também é público.
GITHUB_DATA_REPO = "freitasnascimentomarinha-debug/Testebot"
GITHUB_TOKEN = "github_pat_..."
# GITHUB_DATA_BRANCH = "tradebot-data"
# GITHUB_FLUSH_SECONDS = 20

# Opção B — banco Postgres gratuito para os dados não sumirem (Neon ou Supabase).
# Neon:     postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Supabase (Connect → Session pooler): postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
#   (senha com caracteres especiais precisa ser codificada na URL, ex.: @ vira %40)
DATABASE_URL = ""

# Fase 2 — negociação real (ainda não utilizado)
# BINANCE_API_KEY = ""
# BINANCE_API_SECRET = ""
# BINANCE_TESTNET = true
